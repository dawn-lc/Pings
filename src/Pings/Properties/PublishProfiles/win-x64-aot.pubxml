<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Native AOT 发布配置：单个自包含 exe，不依赖 .NET 运行时。

    用法（**必须在 Windows 上执行**，见文末「为什么不能交叉编译」）：
      dotnet publish src\Pings\Pings.csproj -c Release -f net10.0-windows ^
        -p:PublishProfile=src\Pings\Properties\PublishProfiles\win-x64-aot.pubxml ^
        -p:AppVersion=1.0.22 -p:AppVersionType=Release -o dist\aot

    产物：dist\aot\Pings.exe（单文件，约 4 MB）。不写 -o 时默认落在
    src\Pings\bin\Release\net10.0-windows\win-x64\publish\Pings.exe。

    注意 -f net10.0-windows 不能省：本项目是多目标框架（net10.0;net10.0-windows），
    而 <TargetFramework> 在本文件里只在「已经选定 TFM」之后才生效 —— 跨目标求值阶段
    仍会报 NETSDK1129（未指定目标框架无法 Publish）。

    UPX 压缩由 csproj 的 UpxCompressNativeBinary target 完成（原地压缩 $(PublishDir) 里的
    原生 exe），不需要额外脚本：tools\upx\upx.exe 存在就自动压缩，否则自动下载；
    用 -p:EnableUpx=false 关闭，-p:UpxPath=... 换一个。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishAot>true</PublishAot>

    <!--
      AOT 产物是纯原生代码，没有 apphost / bundle 概念：
      单文件与 bundle 压缩都不适用（AOT 输出本身就是单个原生 PE）。
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      不设 InvariantGlobalization：本项目需要正确的区域性行为（日期格式、GBK 迁移探测），
      不变全球化会把文化固定为 Invariant。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      DebugType/DebugSymbols 管不到 ILCompiler 的原生符号：
      _CopyAotSymbols 由 CopyOutputSymbolsToPublishDirectory 控制，默认 true，
      会往发布目录塞一个几十 MB 的 .pdb，破坏「单 exe 下载」形态。
    -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- AOT 常用精简开关；UseSystemResourceKeys 只影响框架内部异常文案 -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <!--
    为什么不能交叉编译：
    Microsoft.NETCore.Native.Publish.targets 里有硬性检查 ——
      <Error Condition="'$(OS)' != 'Windows_NT' and '$(_targetOS)' == 'win'"
             Text="Cross-OS native compilation is not supported." />
    即使加 -p:DisableUnsupportedError=true 绕过去，Linux 上也没有 MSVC 链接器与
    Windows SDK 的导入库（kernel32.lib 等），ILCompiler 仍然无法产出 PE。
    所以 Windows AOT 必须在 Windows 上构建：本地用本机 SDK，CI 用 windows-latest
    （见 .github/workflows/Release.yml）。
    非 Windows 平台可以正常发布自己的 AOT（例如 -r linux-x64），UPX target 会自动跳过。
  -->

</Project>
